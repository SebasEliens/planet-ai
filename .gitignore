# Claude Code local symlink (points at AGENTS.md)
CLAUDE.md

# Build output
/build/
/site/
/public/

# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.python-version.local

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Agent run artifacts — PR-body/title scratch, regenerated each run and consumed by
# research.yml. candidates.json is NOT ignored: it's committed with the PR for
# transparency (see docs/DESIGN.md §2b).
/agent/run-summary.md
/agent/pr-title.txt
/agent/.cache/

# Local source excerpts kept out of the published build
# (verification material; see docs/DESIGN.md → Legal & licensing)
/kb/sources/**/_raw/

# Secrets / local env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
